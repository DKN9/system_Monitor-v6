    def load_system_events(self):
        cmd = 'powershell -Command "Get-EventLog -LogName System -EntryType Error,Warning -Newest 15 | Select-Object TimeGenerated, Source, EventID, Message | Format-List"'
        self.run_cmd_async(cmd, self.event_text)

    def load_app_events(self):
        cmd = 'powershell -Command "Get-EventLog -LogName Application -EntryType Error,Warning -Newest 15 | Select-Object TimeGenerated, Source, EventID, Message | Format-List"'
        self.run_cmd_async(cmd, self.event_text)


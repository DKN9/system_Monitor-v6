# -*- coding: utf-8 -*-
import os
import platform
import subprocess
import threading
import time
from datetime import datetime
import tkinter as tk
from tkinter import filedialog, messagebox, ttk
import winreg
import psutil


class ComprehensiveSystemMonitorApp:

    def __init__(self, root):
        self.root = root
        self.root.title("Daim's PC Health, Hardware & Diagnostic Suite")
        self.root.geometry("1020x980")
        self.root.minsize(850, 750)

        # Theme state (False = Light, True = Dark)
        self.dark_mode = True

        # Define Color Palettes
        self.colors = {
            "dark": {
                "bg": "#1E222A",
                "card_bg": "#282C34",
                "fg": "#ABB2BF",
                "accent": "#61AFEF",
                "accent_fg": "#1E222A",
                "button_bg": "#3E4451",
                "button_fg": "#FFFFFF",
                "danger_bg": "#E06C75",
                "success_bg": "#98C379",
                "warning_bg": "#E5C07B",
                "info_bg": "#61AFEF",
                "text_area_bg": "#181A1F",
                "text_area_fg": "#98C379",
            },
            "light": {
                "bg": "#F4F5F7",
                "card_bg": "#FFFFFF",
                "fg": "#212529",
                "accent": "#0056B3",
                "accent_fg": "#FFFFFF",
                "button_bg": "#E9ECEF",
                "button_fg": "#212529",
                "danger_bg": "#DC3545",
                "success_bg": "#28A745",
                "warning_bg": "#FFC107",
                "info_bg": "#17A2B8",
                "text_area_bg": "#212529",
                "text_area_fg": "#20C997",
            },
        }

        self.style = ttk.Style()
        self.setup_themes()

        # --- Top Control Bar (Live Time & Theme Toggle) ---
        top_bar = tk.Frame(root, bg=self.get_c("bg"), padx=5, pady=5)
        top_bar.pack(fill="x", padx=10, pady=(5, 0))

        self.clock_label = tk.Label(
            top_bar,
            text="",
            font=("Consolas", 10, "bold"),
            bg=self.get_c("bg"),
            fg=self.get_c("accent"),
        )
        self.clock_label.pack(side=tk.LEFT, padx=5)

        self.theme_btn = tk.Button(
            top_bar,
            text="Toggle Light Mode" if self.dark_mode else "Toggle Dark Mode",
            font=("Arial", 9, "bold"),
            bg=self.get_c("button_bg"),
            fg=self.get_c("button_fg"),
            activebackground=self.get_c("accent"),
            relief="flat",
            bd=0,
            padx=10,
            pady=3,
            command=self.toggle_theme,
        )
        self.theme_btn.pack(side=tk.RIGHT)

        self.update_live_clock()

        # Notebook (Tabs Container)
        self.notebook = ttk.Notebook(root)
        self.notebook.pack(fill="both", expand=True, padx=10, pady=5)

        # Build All Required Tabs
        self.build_tab_perf_history()
        self.build_tab_gpu()
        self.build_tab_process_manager()
        self.build_tab_services()
        self.build_tab_startup_apps()
        self.build_tab_disk_storage()
        self.build_tab_battery()
        self.build_tab_hardware_info()
        self.build_tab_win_security()
        self.build_tab_network_adapters()
        self.build_tab_event_logs()
        self.build_tab_quick_diagnostics()

        # Background Metric Monitoring Thread
        self.is_running = True
        self.monitor_thread = threading.Thread(target=self.update_metrics_loop)
        self.monitor_thread.daemon = True
        self.monitor_thread.start()

    def get_c(self, key):
        theme_str = "dark" if self.dark_mode else "light"
        return self.colors[theme_str][key]

    def update_live_clock(self):
        current_time_str = datetime.now().strftime(
            " DATE: %Y-%m-%d  TIME: %H:%M:%S"
        )
        self.clock_label.config(text=current_time_str)
        self.root.after(1000, self.update_live_clock)

    def setup_themes(self):
        c = "dark" if self.dark_mode else "light"
        theme_data = self.colors[c]

        self.style.theme_use("clam")
        self.root.configure(bg=theme_data["bg"])

        self.style.configure("TFrame", background=theme_data["bg"])
        self.style.configure(
            "TLabelframe",
            background=theme_data["card_bg"],
            foreground=theme_data["accent"],
            bordercolor=theme_data["button_bg"],
            relief="solid",
        )
        self.style.configure(
            "TLabelframe.Label",
            background=theme_data["card_bg"],
            foreground=theme_data["accent"],
            font=("Arial", 9, "bold"),
        )
        self.style.configure(
            "TLabel",
            background=theme_data["card_bg"],
            foreground=theme_data["fg"],
        )
        self.style.configure(
            "TNotebook",
            background=theme_data["bg"],
            borderwidth=0,
        )
        self.style.configure(
            "TNotebook.Tab",
            background=theme_data["card_bg"],
            foreground=theme_data["fg"],
            padding=[8, 4],
            font=("Arial", 8, "bold"),
        )
        self.style.map(
            "TNotebook.Tab",
            background=[("selected", theme_data["accent"])],
            foreground=[("selected", theme_data["accent_fg"])],
        )
        self.style.configure(
            "Horizontal.TProgressbar",
            troughcolor=theme_data["bg"],
            background=theme_data["accent"],
            bordercolor=theme_data["card_bg"],
            thickness=14,
        )
        self.style.configure(
            "Treeview",
            background=theme_data["card_bg"],
            foreground=theme_data["fg"],
            fieldbackground=theme_data["card_bg"],
            rowheight=22,
        )
        self.style.configure(
            "Treeview.Heading",
            background=theme_data["button_bg"],
            foreground=theme_data["button_fg"],
            font=("Arial", 8, "bold"),
        )

    def toggle_theme(self):
        self.dark_mode = not self.dark_mode
        self.setup_themes()

        self.root.config(bg=self.get_c("bg"))
        self.theme_btn.config(
            text="Toggle Light Mode" if self.dark_mode else "Toggle Dark Mode",
            bg=self.get_c("button_bg"),
            fg=self.get_c("button_fg"),
        )
        self.clock_label.config(bg=self.get_c("bg"), fg=self.get_c("accent"))

        # Dynamic Text Areas refresh
        for tw in [
            getattr(self, "gpu_text", None),
            getattr(self, "hw_text", None),
            getattr(self, "sec_text", None),
            getattr(self, "net_text", None),
            getattr(self, "event_text", None),
            getattr(self, "diag_text", None),
        ]:
            if tw:
                tw.config(
                    bg=self.get_c("text_area_bg"),
                    fg=self.get_c("text_area_fg"),
                    insertbackground=self.get_c("fg"),
                )

    def launch_win_tool(self, command):
        try:
            if platform.system() == "Windows":
                if command.startswith("ms-settings:"):
                    os.startfile(command)
                else:
                    subprocess.Popen(command, shell=True)
            else:
                messagebox.showinfo("OS Notice", f"'{command}' is Windows specific.")
        except Exception as e:
            messagebox.showerror("Execution Error", f"Failed to launch:\n{e}")

    def run_cmd_async(self, command, text_widget, clear_before=True):
        def task():
            try:
                output = subprocess.check_output(
                    command, shell=True, stderr=subprocess.STDOUT, text=True
                )
            except subprocess.CalledProcessError as e:
                output = e.output if e.output else str(e)
            except Exception as e:
                output = str(e)

            self.root.after(0, self.append_to_text_widget, text_widget, output, clear_before)

        text_widget.config(state="normal")
        if clear_before:
            text_widget.delete("1.0", tk.END)
        text_widget.insert(tk.END, f"Executing: {command}\nPlease wait...\n\n")
        text_widget.config(state="disabled")
        threading.Thread(target=task, daemon=True).start()

    def append_to_text_widget(self, text_widget, content, clear_before=True):
        text_widget.config(state="normal")
        if clear_before:
            text_widget.delete("1.0", tk.END)
        text_widget.insert(tk.END, content)
        text_widget.config(state="disabled")

    def save_log_to_file(self, text_widget):
        log_content = text_widget.get("1.0", tk.END).strip()
        if not log_content:
            messagebox.showwarning("Empty Log", "No log content available to save.")
            return
        file_path = filedialog.asksaveasfilename(
            defaultextension=".txt",
            filetypes=[("Text Files", "*.txt"), ("All Files", "*.*")],
            title="Save Output Log",
        )
        if file_path:
            try:
                with open(file_path, "w", encoding="utf-8") as f:
                    f.write(log_content)
                messagebox.showinfo("Saved", f"Log written to:\n{file_path}")
            except Exception as e:
                messagebox.showerror("Error", f"Failed to write file: {e}")

    # =========================================================================
    # TAB 1: Performance History
    # =========================================================================
    def build_tab_perf_history(self):
        tab = ttk.Frame(self.notebook, style="TFrame")
        self.notebook.add(tab, text="Perf History")

        # CPU Overview
        cpu_frame = ttk.LabelFrame(tab, text=" CPU Realtime Metrics ", padding=10)
        cpu_frame.pack(fill="x", padx=10, pady=5)
        self.cpu_info_label = ttk.Label(cpu_frame, text="Calculating CPU...", font=("Arial", 9, "bold"))
        self.cpu_info_label.pack(anchor="w")
        self.cpu_bar = ttk.Progressbar(cpu_frame, orient="horizontal", mode="determinate")
        self.cpu_bar.pack(fill="x", pady=5)

        # RAM Overview
        ram_frame = ttk.LabelFrame(tab, text=" RAM Memory Usage ", padding=10)
        ram_frame.pack(fill="x", padx=10, pady=5)
        self.ram_label = ttk.Label(ram_frame, text="Calculating Memory...", font=("Arial", 9))
        self.ram_label.pack(anchor="w")
        self.ram_bar = ttk.Progressbar(ram_frame, orient="horizontal", mode="determinate")
        self.ram_bar.pack(fill="x", pady=5)

        # Network Throughput
        net_frame = ttk.LabelFrame(tab, text=" Live Network Speed ", padding=10)
        net_frame.pack(fill="x", padx=10, pady=5)
        self.net_io_label = ttk.Label(net_frame, text="Upload: 0.00 KB/s | Download: 0.00 KB/s", font=("Arial", 9, "bold"))
        self.net_io_label.pack(anchor="w")

        # Per-Core Breakdown
        cores_frame = ttk.LabelFrame(tab, text=" Logical CPU Cores ", padding=10)
        cores_frame.pack(fill="both", expand=True, padx=10, pady=5)

        canvas = tk.Canvas(cores_frame, borderwidth=0, highlightthickness=0, bg=self.get_c("card_bg"))
        scroll_frame = ttk.Frame(canvas, style="TFrame")
        scrollbar = ttk.Scrollbar(cores_frame, orient="vertical", command=canvas.yview)
        canvas.configure(yscrollcommand=scrollbar.set)

        scrollbar.pack(side="right", fill="y")
        canvas.pack(side="left", fill="both", expand=True)
        canvas.create_window((0, 0), window=scroll_frame, anchor="nw")
        scroll_frame.bind("<Configure>", lambda e: canvas.configure(scrollregion=canvas.bbox("all")))

        self.core_bars = []
        count = psutil.cpu_count(logical=True) or 1
        for i in range(count):
            lbl = ttk.Label(scroll_frame, text=f"Core {i}: 0%", font=("Arial", 8))
            lbl.pack(anchor="w", padx=5, pady=(2, 0))
            bar = ttk.Progressbar(scroll_frame, orient="horizontal", length=550, mode="determinate")
            bar.pack(fill="x", padx=5, pady=(0, 4))
            self.core_bars.append((lbl, bar))

    # =========================================================================
    # TAB 2: GPU Monitor
    # =========================================================================
    def build_tab_gpu(self):
        tab = ttk.Frame(self.notebook, style="TFrame")
        self.notebook.add(tab, text="GPU Monitor")

        ctrl_frame = ttk.Frame(tab, padding=10)
        ctrl_frame.pack(fill="x")

        btn_gpu = tk.Button(
            ctrl_frame,
            text="Query GPU Controllers & VRAM",
            bg=self.get_c("button_bg"),
            fg=self.get_c("button_fg"),
            font=("Arial", 9, "bold"),
            relief="flat",
            bd=0,
            padx=10,
            pady=5,
            command=self.load_gpu_info,
        )
        btn_gpu.pack(side=tk.LEFT)

        out_frame = ttk.LabelFrame(tab, text=" GPU Diagnostic Output ", padding=10)
        out_frame.pack(fill="both", expand=True, padx=10, pady=5)

        self.gpu_text = tk.Text(
            out_frame,
            font=("Consolas", 9),
            bg=self.get_c("text_area_bg"),
            fg=self.get_c("text_area_fg"),
            insertbackground=self.get_c("fg"),
            relief="flat",
        )
        self.gpu_text.pack(fill="both", expand=True, side=tk.LEFT)
        scroll = ttk.Scrollbar(out_frame, command=self.gpu_text.yview)
        scroll.pack(side=tk.RIGHT, fill="y")
        self.gpu_text.config(yscrollcommand=scroll.set)

        self.load_gpu_info()

    def load_gpu_info(self):
        cmd = 'powershell -Command "Get-CimInstance Win32_VideoController | Select-Object Name, DriverVersion, VideoProcessor, AdapterRAM, Status | Format-List"'
        self.run_cmd_async(cmd, self.gpu_text)

    # =========================================================================
    # TAB 3: Process Manager
    # =========================================================================
    def build_tab_process_manager(self):
        tab = ttk.Frame(self.notebook, style="TFrame")
        self.notebook.add(tab, text="Process Manager")

        ctrl_frame = ttk.Frame(tab, padding=10)
        ctrl_frame.pack(fill="x")

        btn_ref = tk.Button(
            ctrl_frame,
            text="Refresh Processes",
            bg=self.get_c("button_bg"),
            fg=self.get_c("button_fg"),
            font=("Arial", 9, "bold"),
            relief="flat",
            bd=0,
            padx=10,
            pady=5,
            command=self.load_process_list,
        )
        btn_ref.pack(side=tk.LEFT, padx=5)

        btn_kill = tk.Button(
            ctrl_frame,
            text="Kill Process",
            bg=self.get_c("danger_bg"),
            fg="#FFFFFF",
            font=("Arial", 9, "bold"),
            relief="flat",
            bd=0,
            padx=10,
            pady=5,
            command=self.kill_selected_process,
        )
        btn_kill.pack(side=tk.RIGHT, padx=5)

        table_frame = ttk.LabelFrame(tab, text=" Top Active Processes ", padding=10)
        table_frame.pack(fill="both", expand=True, padx=10, pady=5)

        cols = ("pid", "name", "cpu", "mem")
        self.proc_tree = ttk.Treeview(table_frame, columns=cols, show="headings", height=20)
        self.proc_tree.heading("pid", text="PID")
        self.proc_tree.heading("name", text="Process Name")
        self.proc_tree.heading("cpu", text="CPU (%)")
        self.proc_tree.heading("mem", text="Memory (%)")

        self.proc_tree.column("pid", width=80, anchor="center")
        self.proc_tree.column("name", width=350, anchor="w")
        self.proc_tree.column("cpu", width=120, anchor="center")
        self.proc_tree.column("mem", width=120, anchor="center")

        scroll = ttk.Scrollbar(table_frame, orient="vertical", command=self.proc_tree.yview)
        self.proc_tree.configure(yscrollcommand=scroll.set)
        self.proc_tree.pack(side=tk.LEFT, fill="both", expand=True)
        scroll.pack(side=tk.RIGHT, fill="y")

        self.load_process_list()

    def load_process_list(self):
        for item in self.proc_tree.get_children():
            self.proc_tree.delete(item)

        def fetch():
            procs = []
            for p in psutil.process_iter(["pid", "name", "cpu_percent", "memory_percent"]):
                try:
                    procs.append(
                        (
                            p.info["pid"],
                            p.info["name"] or "Unknown",
                            p.info["cpu_percent"] or 0.0,
                            p.info["memory_percent"] or 0.0,
                        )
                    )
                except (psutil.NoSuchProcess, psutil.AccessDenied):
                    pass
            procs = sorted(procs, key=lambda x: x[2], reverse=True)[:60]
            self.root.after(0, self.update_proc_tree, procs)

        threading.Thread(target=fetch, daemon=True).start()

    def update_proc_tree(self, procs):
        for p in procs:
            self.proc_tree.insert("", tk.END, values=(p[0], p[1], f"{p[2]:.1f}", f"{p[3]:.1f}"))

    def kill_selected_process(self):
        selected = self.proc_tree.selection()
        if not selected:
            messagebox.showwarning("Select Process", "Please select a process from the table.")
            return
        vals = self.proc_tree.item(selected[0], "values")
        pid = int(vals[0])
        name = vals[1]

        if messagebox.askyesno("Confirm Kill", f"Terminate '{name}' (PID: {pid})?"):
            try:
                psutil.Process(pid).terminate()
                messagebox.showinfo("Success", f"Terminated {name}")
                self.load_process_list()
            except Exception as e:
                messagebox.showerror("Error", f"Could not kill process: {e}")

    # =========================================================================
    # TAB 4: Services
    # =========================================================================
    def build_tab_services(self):
        tab = ttk.Frame(self.notebook, style="TFrame")
        self.notebook.add(tab, text="Services")

        ctrl_frame = ttk.Frame(tab, padding=10)
        ctrl_frame.pack(fill="x")

        btn_ref = tk.Button(
            ctrl_frame,
            text="Load Windows Services",
            bg=self.get_c("button_bg"),
            fg=self.get_c("button_fg"),
            font=("Arial", 9, "bold"),
            relief="flat",
            bd=0,
            padx=10,
            pady=5,
            command=self.load_win_services,
        )
        btn_ref.pack(side=tk.LEFT)

        btn_msc = tk.Button(
            ctrl_frame,
            text="Open Services Manager (services.msc)",
            bg=self.get_c("info_bg"),
            fg="#FFFFFF",
            font=("Arial", 9, "bold"),
            relief="flat",
            bd=0,
            padx=10,
            pady=5,
            command=lambda: self.launch_win_tool("services.msc"),
        )
        btn_msc.pack(side=tk.RIGHT)

        table_frame = ttk.LabelFrame(tab, text=" Installed Windows Services ", padding=10)
        table_frame.pack(fill="both", expand=True, padx=10, pady=5)

        cols = ("name", "display", "status")
        self.svc_tree = ttk.Treeview(table_frame, columns=cols, show="headings", height=20)
        self.svc_tree.heading("name", text="Service Name")
        self.svc_tree.heading("display", text="Display Name")
        self.svc_tree.heading("status", text="Status")

        self.svc_tree.column("name", width=200, anchor="w")
        self.svc_tree.column("display", width=400, anchor="w")
        self.svc_tree.column("status", width=100, anchor="center")

        scroll = ttk.Scrollbar(table_frame, orient="vertical", command=self.svc_tree.yview)
        self.svc_tree.configure(yscrollcommand=scroll.set)
        self.svc_tree.pack(side=tk.LEFT, fill="both", expand=True)
        scroll.pack(side=tk.RIGHT, fill="y")

        self.load_win_services()

    def load_win_services(self):
        for item in self.svc_tree.get_children():
            self.svc_tree.delete(item)

        def fetch():
            svcs = []
            if platform.system() == "Windows":
                for s in psutil.win_service_iter():
                    try:
                        info = s.as_dict()
                        svcs.append((info["name"], info["display_name"], info["status"]))
                    except Exception:
                        pass
            self.root.after(0, self.update_svc_tree, svcs)

        threading.Thread(target=fetch, daemon=True).start()

    def update_svc_tree(self, svcs):
        for s in svcs:
            self.svc_tree.insert("", tk.END, values=s)

    # =========================================================================
    # TAB 5: Startup Apps
    # =========================================================================
    def build_tab_startup_apps(self):
        tab = ttk.Frame(self.notebook, style="TFrame")
        self.notebook.add(tab, text="Startup Apps")

        ctrl_frame = ttk.Frame(tab, padding=10)
        ctrl_frame.pack(fill="x")

        btn_ref = tk.Button(
            ctrl_frame,
            text="Query Startup Registry Entries",
            bg=self.get_c("button_bg"),
            fg=self.get_c("button_fg"),
            font=("Arial", 9, "bold"),
            relief="flat",
            bd=0,
            padx=10,
            pady=5,
            command=self.load_startup_apps,
        )
        btn_ref.pack(side=tk.LEFT)

        table_frame = ttk.LabelFrame(tab, text=" Configured Startup Applications ", padding=10)
        table_frame.pack(fill="both", expand=True, padx=10, pady=5)

        cols = ("location", "name", "path")
        self.startup_tree = ttk.Treeview(table_frame, columns=cols, show="headings", height=20)
        self.startup_tree.heading("location", text="Scope")
        self.startup_tree.heading("name", text="Application Name")
        self.startup_tree.heading("path", text="Executable Path / Command")

        self.startup_tree.column("location", width=120, anchor="center")
        self.startup_tree.column("name", width=200, anchor="w")
        self.startup_tree.column("path", width=450, anchor="w")

        scroll = ttk.Scrollbar(table_frame, orient="vertical", command=self.startup_tree.yview)
        self.startup_tree.configure(yscrollcommand=scroll.set)
        self.startup_tree.pack(side=tk.LEFT, fill="both", expand=True)
        scroll.pack(side=tk.RIGHT, fill="y")

        self.load_startup_apps()

    def load_startup_apps(self):
        for item in self.startup_tree.get_children():
            self.startup_tree.delete(item)

        entries = []
        locations = [
            (winreg.HKEY_CURRENT_USER, r"Software\Microsoft\Windows\CurrentVersion\Run", "HKCU Run"),
            (winreg.HKEY_LOCAL_MACHINE, r"Software\Microsoft\Windows\CurrentVersion\Run", "HKLM Run"),
        ]

        for hkey, subkey, label in locations:
            try:
                key = winreg.OpenKey(hkey, subkey, 0, winreg.KEY_READ)
                i = 0
                while True:
                    try:
                        name, val, _ = winreg.EnumValue(key, i)
                        entries.append((label, name, val))
                        i += 1
                    except OSError:
                        break
                winreg.CloseKey(key)
            except Exception:
                pass

        for entry in entries:
            self.startup_tree.insert("", tk.END, values=entry)

    # =========================================================================
    # TAB 6: Disk & Storage
    # =========================================================================
    def build_tab_disk_storage(self):
        tab = ttk.Frame(self.notebook, style="TFrame")
        self.notebook.add(tab, text="Disk & Storage")

        ctrl_frame = ttk.Frame(tab, padding=10)
        ctrl_frame.pack(fill="x")

        btn_ref = tk.Button(
            ctrl_frame,
            text="Refresh Drive Partitions & IO",
            bg=self.get_c("button_bg"),
            fg=self.get_c("button_fg"),
            font=("Arial", 9, "bold"),
            relief="flat",
            bd=0,
            padx=10,
            pady=5,
            command=self.load_disk_info,
        )
        btn_ref.pack(side=tk.LEFT)

        self.disk_container = ttk.LabelFrame(tab, text=" Mounted Volumes & Space ", padding=10)
        self.disk_container.pack(fill="both", expand=True, padx=10, pady=5)

        self.load_disk_info()

    def load_disk_info(self):
        for widget in self.disk_container.winfo_children():
            widget.destroy()

        try:
            partitions = psutil.disk_partitions()
            for p in partitions:
                try:
                    usage = psutil.disk_usage(p.mountpoint)
                    p_frame = ttk.Frame(self.disk_container, padding=5)
                    p_frame.pack(fill="x", pady=5)

                    lbl_text = f"Drive {p.device} ({p.mountpoint}) [{p.fstype}] - Free: {usage.free / (1024**3):.1f} GB / Total: {usage.total / (1024**3):.1f} GB ({usage.percent}% Used)"
                    ttk.Label(p_frame, text=lbl_text, font=("Arial", 9, "bold")).pack(anchor="w")

                    bar = ttk.Progressbar(p_frame, orient="horizontal", mode="determinate", value=usage.percent)
                    bar.pack(fill="x", pady=2)
                except PermissionError:
                    continue
        except Exception as e:
            ttk.Label(self.disk_container, text=f"Error reading disk partitions: {e}").pack()

    # =========================================================================
    # TAB 7: Battery
    # =========================================================================
    def build_tab_battery(self):
        tab = ttk.Frame(self.notebook, style="TFrame")
        self.notebook.add(tab, text="Battery")

        box = ttk.LabelFrame(tab, text=" Battery & Power Status ", padding=15)
        box.pack(fill="x", padx=15, pady=15)

        self.batt_label = ttk.Label(box, text="Checking battery status...", font=("Arial", 11, "bold"))
        self.batt_label.pack(anchor="w", pady=5)

        self.batt_bar = ttk.Progressbar(box, orient="horizontal", mode="determinate")
        self.batt_bar.pack(fill="x", pady=10)

        self.batt_details = ttk.Label(box, text="", font=("Arial", 9))
        self.batt_details.pack(anchor="w")

        self.update_battery_status()

    def update_battery_status(self):
        battery = psutil.sensors_battery()
        if battery:
            pct = battery.percent
            plugged = "AC Power Connected (Charging)" if battery.power_plugged else "Running on Battery"
            secs = battery.secsleft
            time_str = f"Estimated Time Remaining: {secs // 3600}h {(secs % 3600) // 60}m" if secs > 0 and secs != psutil.POWER_TIME_UNLIMITED else "Time Remaining: Calculating / AC Power"

            self.batt_label.config(text=f"Battery Charge: {pct}%")
            self.batt_bar["value"] = pct
            self.batt_details.config(text=f"Power State: {plugged}\n{time_str}")
        else:
            self.batt_label.config(text="No Battery Detected (Desktop Computer / AC Only)")
            self.batt_bar["value"] = 100
            self.batt_details.config(text="System is operating without a battery sensor.")


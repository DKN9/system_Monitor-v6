        self.diag_text.config(yscrollcommand=scroll.set)

    # =========================================================================
    # Metric Loop
    # =========================================================================
    def update_metrics_loop(self):
        last_net_io = psutil.net_io_counters()
        last_time = time.time()

        while self.is_running:
            time.sleep(1)
            if not self.is_running:
                break

            ram = psutil.virtual_memory()
            ram_text = f"Used: {ram.used / (1024**3):.2f} GB / Total: {ram.total / (1024**3):.2f} GB ({ram.percent}%)"

            cpu_pct = psutil.cpu_percent(interval=None)
            cpu_text = f"Overall CPU Usage: {cpu_pct:.1f}%"

            core_pcts = psutil.cpu_percent(percpu=True)

            curr_net_io = psutil.net_io_counters()
            curr_time = time.time()
            dt = curr_time - last_time if (curr_time - last_time) > 0 else 1.0

            up_speed = (curr_net_io.bytes_sent - last_net_io.bytes_sent) / dt / 1024.0
            down_speed = (curr_net_io.bytes_recv - last_net_io.bytes_recv) / dt / 1024.0

            last_net_io = curr_net_io
            last_time = curr_time

            self.root.after(0, self.update_metrics_gui, ram_text, ram.percent, cpu_text, cpu_pct, core_pcts, up_speed, down_speed)

    def update_metrics_gui(self, ram_text, ram_pct, cpu_text, cpu_pct, core_pcts, up_speed, down_speed):
        if hasattr(self, "ram_label"):
            self.ram_label.config(text=ram_text)
            self.ram_bar["value"] = ram_pct

        if hasattr(self, "cpu_info_label"):
            self.cpu_info_label.config(text=cpu_text)
            self.cpu_bar["value"] = cpu_pct

        if hasattr(self, "net_io_label"):
            self.net_io_label.config(text=f"Upload: {up_speed:.2f} KB/s | Download: {down_speed:.2f} KB/s")

        if hasattr(self, "core_bars"):
            for idx, (lbl, bar) in enumerate(self.core_bars):
                if idx < len(core_pcts):
                    val = core_pcts[idx]
                    lbl.config(text=f"Core {idx}: {val:.1f}%")
                    bar["value"] = val

        self.update_battery_status()


if __name__ == "__main__":
    root = tk.Tk()
    app = ComprehensiveSystemMonitorApp(root)
    root.mainloop()

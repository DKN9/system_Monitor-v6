    # =========================================================================
    def build_tab_hardware_info(self):
        tab = ttk.Frame(self.notebook, style="TFrame")
        self.notebook.add(tab, text="Hardware Info")

        ctrl_frame = ttk.Frame(tab, padding=10)
        ctrl_frame.pack(fill="x")

        btn_hw = tk.Button(
            ctrl_frame,
            text="Generate Detailed Hardware Spec Report",
            bg=self.get_c("success_bg"),
            fg="#1E222A",
            font=("Arial", 9, "bold"),
            relief="flat",
            bd=0,
            padx=10,
            pady=5,
            command=self.load_hardware_report,
        )
        btn_hw.pack(side=tk.LEFT)

        out_frame = ttk.LabelFrame(tab, text=" Complete Hardware Diagnostics ", padding=10)
        out_frame.pack(fill="both", expand=True, padx=10, pady=5)

        self.hw_text = tk.Text(
            out_frame,
            font=("Consolas", 9),
            bg=self.get_c("text_area_bg"),
            fg=self.get_c("text_area_fg"),
            insertbackground=self.get_c("fg"),
            relief="flat",
        )
        self.hw_text.pack(fill="both", expand=True, side=tk.LEFT)
        scroll = ttk.Scrollbar(out_frame, command=self.hw_text.yview)
        scroll.pack(side=tk.RIGHT, fill="y")
        self.hw_text.config(yscrollcommand=scroll.set)

        self.load_hardware_report()

    def load_hardware_report(self):
        cmd = 'powershell -Command "Get-CimInstance Win32_ComputerSystem | Format-List Manufacturer, Model, TotalPhysicalMemory; Get-CimInstance Win32_Processor | Format-List Name, NumberOfCores, NumberOfLogicalProcessors, MaxClockSpeed; Get-CimInstance Win32_BIOS | Format-List Manufacturer, SMBIOSBIOSVersion, ReleaseDate"'
        self.run_cmd_async(cmd, self.hw_text)

